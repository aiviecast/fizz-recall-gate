import self as gate
import fizz_protocol.memory
import list

local fn ev(id: Int, content: String) -> memory.MemoryEvent = {
  let empty_tags: List[String] = []
  memory.MemoryEvent {
    id: id, user_id: 1, session_id: none, role: memory.User,
    content: content, ts: id, tags: empty_tags,
  }
}

local fn user(id: Int, msgs: Int) -> memory.MemoryUser =
  memory.MemoryUser {
    id: id, name: "u${id}", first_seen: 0, last_seen: 100,
    message_count: msgs, summary: none, summary_updated_at: none,
  }

local fn full(recent: List[memory.MemoryEvent]) -> memory.RecallResult = {
  let no_parts: List[memory.SessionParticipation] = []
  memory.RecallResult {
    user: user(1, 10), recent: recent, is_returning: true,
    days_since_last_seen: 3, session_user_count: 5, session_started_at: some(1000),
    total_user_count: 10, past_sessions: none, recent_sessions: no_parts, engagement: none,
  }
}

local fn content_of(o: Option[memory.MemoryEvent]) -> String =
  match o { some(e) => e.content, none => "<none>" }

test "gate trims recent to the cap, keeping the newest; passes other fields through" {
  let r = full([ev(1, "a"), ev(2, "b"), ev(3, "c"), ev(4, "d"), ev(5, "e")])
  let g = gate.gate(r, 2)
  assert_eq(list.len(g.recent), 2)
  assert_eq(content_of(list.first(g.recent)), "d")
  assert_eq(content_of(list.last(g.recent)), "e")
  // 他フィールドは素通し
  assert_eq(g.is_returning, true)
  assert_eq(g.days_since_last_seen, 3)
  assert_eq(g.total_user_count, 10)
}

test "gate with cap >= length keeps everything; cap<0 floors to 0" {
  let r = full([ev(1, "a"), ev(2, "b")])
  assert_eq(list.len(gate.gate(r, 9).recent), 2)
  assert_eq(list.len(gate.gate(r, -3).recent), 0)
}

test "empty_for is a memory-less result for a known user" {
  let g = gate.empty_for(user(7, 42))
  assert_eq(list.len(g.recent), 0)
  assert_eq(g.is_returning, false)
  assert_eq(g.session_user_count, 0)
  assert_eq(g.total_user_count, 42)   // user.message_count を反映
  assert_eq(g.user.id, 7)
}

test "empty_unknown fabricates a first-seen user" {
  let g = gate.empty_unknown(99, "ねこ", 500)
  assert_eq(g.user.id, 99)
  assert_eq(g.user.name, "ねこ")
  assert_eq(g.user.first_seen, 500)
  assert_eq(g.user.message_count, 0)
  assert_eq(g.is_returning, false)
  assert_eq(list.len(g.recent), 0)
}
